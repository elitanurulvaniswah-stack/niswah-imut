<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Speed Typer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script>
        // Konfigurasi warna dominan: Pink dan Putih
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#FF69B4', // Pink cerah
                        secondary: '#FFC0CB', // Pink muda
                        light: '#FFFFFF', // Putih
                        darkPink: '#DB2777', // Pink tua
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .text-shadow {
                text-shadow: 2px 2px 4px rgba(219, 39, 119, 0.3);
            }
            .border-pink {
                border: 2px solid #FF69B4;
            }
            .bg-gradient-pink {
                background: linear-gradient(135deg, #FF69B4 0%, #FFC0CB 100%);
            }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-secondary/20 font-sans min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-light shadow-md py-5 px-6">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fa fa-keyboard-o text-primary text-[28px]"></i>
                <h1 class="text-[24px] font-bold text-primary text-shadow">The Speed Typer</h1>
                <span class="text-[20px]">⌨️✨</span> <!-- Stiker/emoji pendukung -->
            </div>
            <p class="text-darkPink font-medium">Uji Kecepatan Mengetikmu!</p>
        </div>
    </header>

    <!-- Konten Utama -->
    <main class="container mx-auto flex-grow py-10 px-4 max-w-3xl">
        <!-- Area Informasi -->
        <div class="bg-light rounded-xl shadow-lg p-6 mb-6 text-center">
            <div class="flex justify-center gap-4 mb-4">
                <span class="text-[32px]">⚡</span>
                <span class="text-[32px]">💨</span>
                <span class="text-[32px]">🏆</span>
            </div>
            <p class="text-gray-700 mb-4">Ketikan teks di bawah ini secepat dan seakurat mungkin dalam waktu 30 detik!</p>
            <div class="flex justify-center gap-8 mb-2">
                <div class="bg-secondary/30 px-4 py-2 rounded-lg">
                    <span class="font-semibold text-darkPink">Waktu: </span>
                    <span id="timer" class="font-bold text-primary text-lg">30</span>
                    <span> detik</span>
                </div>
                <div class="bg-secondary/30 px-4 py-2 rounded-lg">
                    <span class="font-semibold text-darkPink">Skor: </span>
                    <span id="score" class="font-bold text-primary text-lg">0</span>
                </div>
                <div class="bg-secondary/30 px-4 py-2 rounded-lg">
                    <span class="font-semibold text-darkPink">Akurasi: </span>
                    <span id="accuracy" class="font-bold text-primary text-lg">100</span>
                    <span>%</span>
                </div>
            </div>
        </div>

        <!-- Area Teks Target -->
        <div class="bg-light rounded-xl shadow-lg p-6 mb-6">
            <h2 class="text-lg font-semibold text-darkPink mb-3 flex items-center gap-2">
                <span>📝</span> Teks yang Harus Diketik:
            </h2>
            <div id="target-text" class="text-[18px] leading-relaxed p-4 bg-secondary/20 rounded-lg min-h-[80px] text-gray-800 font-medium">
                Keterampilan mengetik cepat sangat berguna di era digital ini, latihan rutin akan membuat jari-jari semakin lincah dan terbiasa dengan susunan huruf pada papan ketik.
            </div>
        </div>

        <!-- Area Input Pengguna -->
        <div class="bg-light rounded-xl shadow-lg p-6 mb-6">
            <h2 class="text-lg font-semibold text-darkPink mb-3 flex items-center gap-2">
                <span>⌨️</span> Mulai Mengetik di Sini:
            </h2>
            <textarea 
                id="user-input" 
                class="w-full p-4 rounded-lg border-pink focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all text-[16px] h-[100px] resize-none"
                placeholder="Ketik teks di sini setelah menekan tombol mulai..."
                disabled
            ></textarea>
        </div>

        <!-- Tombol Aksi -->
        <div class="flex justify-center gap-4">
            <button id="start-btn" class="bg-gradient-pink hover:bg-primary/90 text-white font-semibold py-3 px-8 rounded-full transition-all transform hover:scale-105 shadow-md">
                Mulai Permainan 🚀
            </button>
            <button id="reset-btn" class="bg-light border-pink text-primary hover:bg-secondary/10 font-semibold py-3 px-8 rounded-full transition-all shadow-md">
                Ulangi 🔄
            </button>
        </div>

        <!-- Hasil Akhir -->
        <div id="result" class="hidden mt-8 bg-light rounded-xl shadow-lg p-6 text-center">
            <h2 class="text-[22px] font-bold text-primary mb-2">Permainan Selesai! 🎉</h2>
            <p id="result-text" class="text-lg text-gray-700"></p>
            <div class="mt-3 text-[40px]">🥳</div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-light py-4 mt-8 shadow-inner">
        <div class="container mx-auto text-center text-primary font-medium">
            <p>© 2025 The Speed Typer - Latihan Mengetik Menyenangkan 💖</p>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // Elemen DOM
        const targetTextEl = document.getElementById('target-text');
        const userInputEl = document.getElementById('user-input');
        const timerEl = document.getElementById('timer');
        const scoreEl = document.getElementById('score');
        const accuracyEl = document.getElementById('accuracy');
        const startBtn = document.getElementById('start-btn');
        const resetBtn = document.getElementById('reset-btn');
        const resultEl = document.getElementById('result');
        const resultTextEl = document.getElementById('result-text');

        // Variabel Permainan
        let timer;
        let timeLeft = 30;
        let isPlaying = false;
        let correctChars = 0;
        let totalTyped = 0;
        const targetText = targetTextEl.innerText;

        // Fungsi Mulai Permainan
        startBtn.addEventListener('click', () => {
            if (isPlaying) return;
            
            // Reset status
            timeLeft = 30;
            correctChars = 0;
            totalTyped = 0;
            timerEl.innerText = timeLeft;
            scoreEl.innerText = 0;
            accuracyEl.innerText = 100;
            userInputEl.value = '';
            userInputEl.disabled = false;
            userInputEl.focus();
            resultEl.classList.add('hidden');
            isPlaying = true;

            // Jalankan Timer
            timer = setInterval(() => {
                timeLeft--;
                timerEl.innerText = timeLeft;

                if (timeLeft <= 0) {
                    endGame();
                }
            }, 1000);
        });

        // Fungsi Akhiri Permainan
        function endGame() {
            clearInterval(timer);
            isPlaying = false;
            userInputEl.disabled = true;
            
            // Hitung hasil akhir
            const wordsPerMinute = Math.round((correctChars / 5) / 0.5);
            const accuracy = totalTyped > 0 ? Math.round((correctChars / totalTyped) * 100) : 100;
            
            resultTextEl.innerText = `Kecepatan Anda: ${wordsPerMinute} KPM dengan akurasi ${accuracy}%. ${wordsPerMinute > 40 ? 'Luar biasa! 🔥' : 'Bagus, terus latihan ya! 💪'}`;
            resultEl.classList.remove('hidden');
        }

        // Fungsi Reset Permainan
        resetBtn.addEventListener('click', () => {
            clearInterval(timer);
            isPlaying = false;
            timeLeft = 30;
            timerEl.innerText = timeLeft;
            userInputEl.value = '';
            userInputEl.disabled = true;
            scoreEl.innerText = 0;
            accuracyEl.innerText = 100;
            resultEl.classList.add('hidden');
        });

        // Cek Ketikan Pengguna
        userInputEl.addEventListener('input', () => {
            if (!isPlaying) return;

            const userText = userInputEl.value;
            totalTyped = userText.length;
            correctChars = 0;

            // Hitung karakter yang benar
            for (let i = 0; i < userText.length; i++) {
                if (userText[i] === targetText[i]) {
                    correctChars++;
                }
            }

            // Perbarui skor dan akurasi
            const score = correctChars;
            const accuracy = totalTyped > 0 ? Math.round((correctChars / totalTyped) * 100) : 100;
            
            scoreEl.innerText = score;
            accuracyEl.innerText = accuracy;

            // Ubah warna teks input sesuai kebenaran
            if (userText === targetText) {
                endGame();
            }
        });
    </script>
</body>
</html>
